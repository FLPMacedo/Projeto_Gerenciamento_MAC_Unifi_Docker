# Copie para .env e preencha. NUNCA versione o .env real.
# No Portainer, estes valores vao em "Environment variables" do stack.

# ============================================================ PostgreSQL
PGDATABASE=gestaomac
PGUSER=gestaomac
# OBRIGATORIO. Gere uma senha forte, ex.: openssl rand -base64 24
PGPASSWORD=

# ============================================================ Aplicacao
# Porta do PAINEL DE GESTAO (interna continua 5000)
WEB_PORT=8080
# Porta do PAINEL DE EXIBICAO (portal de vouchers)
PORTAL_PORT=8081

# Teto de vouchers por lote. A UniFi nao documenta um limite rigido e ele varia
# por versao; 200 cobre o uso real e evita que um zero a mais gere milhares.
VOUCHER_MAX_QTD=200

# Segredo de sessao do Flask. Se deixar vazio, o app gera um e guarda no banco
# (todas as replicas compartilham). Para fixar: openssl rand -hex 32
FLASK_SECRET_KEY=

# IMPORTANTE: o codigo formata datas com time.localtime(). Sem TZ o container
# roda em UTC e as telas mostram 3 horas a menos.
TZ=America/Sao_Paulo

LOG_LEVEL=INFO

# Nome da empresa exibido no cabecalho (a logo vai em app/static/logo_brand.png,
# que fica fora do versionamento)
BRAND=

# Unidades do checklist do cadastro
UNITS=101,102,103,104,105,106,107,110,111,113,115,117

# Tratamento de MAC que nunca conectou:
#   grace     -> so vira disponivel 35 dias apos a 1a coleta (protege cadastro novo)
#   immediate -> nunca logou ja conta como disponivel
NEVER_MODE=grace

# Intervalo da coleta, em segundos (padrao 10 min)
COLLECT_INTERVAL=600

# ============================================================ UniFi
# NADA AQUI E OBRIGATORIO. O sistema se configura pela WEB:
#   - cada pessoa entra com a PROPRIA conta UniFi na tela de login;
#   - a credencial fica cifrada no banco e serve para as telas (as acoes saem no
#     log da UniFi com o nome real do autor) e para a coleta automatica, que
#     roda sem ninguem logado;
#   - o endereco do controller e pedido no primeiro acesso e depois se altera
#     pela tela de Configuracao.
#
# As duas variaveis abaixo servem so como SEMENTE do primeiro arranque, para
# poupar o passo de digitar o host na primeira tela.
UNIFI_HOST=
UNIFI_SITE=default
# Deixe false para o certificado autoassinado do Cloud Key
UNIFI_VERIFY_SSL=false

# ---- Conta de servico (OPCIONAL) ----
# Se preencher, a COLETA passa a preferir esta conta em vez da credencial do
# ultimo login. Vantagem: a coleta nunca para porque alguem trocou a senha
# pessoal. As telas continuam usando a conta de cada usuario de qualquer forma.
# UNIFI_SERVICE_USERNAME=
# UNIFI_SERVICE_PASSWORD=
# Em producao, prefira um Docker secret:
# UNIFI_SERVICE_PASSWORD_FILE=/run/secrets/unifi_password

# ---- Chave de criptografia das senhas (OPCIONAL) ----
# Por padrao a chave e gerada sozinha e guardada na tabela settings -- pratico,
# mas fica no mesmo banco do texto cifrado. Definindo CREDS_KEY aqui, a chave
# nunca toca o banco (recomendado em producao).
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDS_KEY=
# CREDS_KEY_FILE=/run/secrets/creds_key
